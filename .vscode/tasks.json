{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-ninja",
            "type": "shell",
            "command": "if exist build rmdir /s /q build && mkdir build && cd build && cmake -G \"Ninja\" .. && ninja",
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        }
    ]
}
